<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SISTEMA MANTENIMIENTO</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApplication_MVC_GRUPO8.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        body {
            display: flex;
            height: 100vh;
            overflow-x: hidden;
            margin-bottom:0px;
        }

        /* barra lateral*/
        .sidebar {
            width: 260px;
            background-color: #0d1b2a;
            color: white;
            flex-shrink: 0;
            padding: 20px 15px;
        }

            .sidebar .brand {
                font-size: 1.3rem;
                font-weight: bold;
            }

            .sidebar .role {
                font-size: 0.9rem;
                color: #adb5bd;
                margin-bottom: 25px;
            }

            .sidebar a {
                color: #adb5bd;
                text-decoration: none;
                padding: 10px 15px;
                display: block;
                border-radius: 8px;
                margin-bottom: 5px;
            }

            .sidebar a:hover,
            .sidebar .active {
                background-color: #1b263b;
                color: white;
                }
            .nav{
            height:90%}

        .containerName{
        height:10%}
        .content-area {
            flex-grow: 1;
            background: #f8f9fa;
            padding: 25px;
            width:100vw;
        }
    </style>

</head>
<body>
    <div class="sidebar">
        <div class="containerName">
            <div class="brand mb-1">
                <i class="bi bi-wrench"></i> Mantenimiento
            </div>

            <div class="role">
                @Context.Session?.GetString("UserRol")?.ToUpper()
            </div>
        </div>

        <nav class="d-flex flex-column justify-content-between mt-3 nav">
            <div>
            <a asp-controller="Home" asp-action="Index"
               class="@(ViewContext?.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                <i class="bi bi-speedometer2 me-2"></i> Dashboard
            </a>

            <a asp-controller="Incidencia" asp-action="Index"
               class="@(ViewContext?.RouteData?.Values["Controller"]?.ToString() == "Incidencia" ? "active" : "")">
                <i class="bi bi-exclamation-circle me-2"></i> Incidencias
            </a>

                <!-- Mostrar solo si es Admin -->
                @if (
                Context?.Session?.GetString("UserRol") == "administrador")
                {
                    <a asp-controller="User" asp-action="Index"
                       class="@(ViewContext?.RouteData?.Values["Controller"]?.ToString() == "User" ? "active" : "")">
                        <i class="bi bi-people me-2"></i> Usuarios
                    </a>
                }
            <!-- Mostrar solo si es Encargado o Admin -->
            @if (Context?.Session?.GetString("UserRol") == "encargado" ||
            Context?.Session?.GetString("UserRol") == "administrador")
            {
                <a asp-controller="Categoria" asp-action="Index"
                   class="@(ViewContext?.RouteData?.Values["Controller"]?.ToString() == "Categoria" ? "active" : "")">
                    <i class="bi bi-bookmark me-2"></i> Categorías
                </a>
            }
            </div>
            <div>
                 <div class="d-flex justify-content-between align-items-center">
                     <div>
                        <i class="bi bi-person-circle"></i> @Context?.Session?.GetString("UserNombre")?.ToUpper()
                     </div>
                        <a asp-controller="Auth" asp-action="Logout" >
                            <i class="bi bi-box-arrow-right me-2"></i> 
                        </a>
                   </div>
            </div>
        </nav>
    </div>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>

     @* <footer class="border-top footer text-muted">  *@
     @*     <div class="container">  *@
     @*         &copy; 2025 - WebApplication_MVC_GRUPO8 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>  *@
     @*     </div>  *@
     @* </footer>  *@
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
