@model WebApplication_MVC_GRUPO8.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>Dashboard</h1>
                <a asp-controller="Incidencia"
                    asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Reportar Incidencia
                </a>
            </div>
            <div class="card shadow">
                <div class="row g-3 mb-4 p-4">

                    <div class="col-6">
                        <div class="p-3 bg-light rounded shadow-sm text-center">
                            <div class="d-flex justify-content-center align-items-center gap-2">
                                <i class="bi bi-clipboard fs-2 text-primary"></i>
                                <h3 class="text-primary m-0">@Model.Activas</h3>
                            </div>
                            <div class="text-dark fw-bold">ACTIVAS</div>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="p-3 bg-light rounded shadow-sm text-center">
                            <div class="d-flex justify-content-center align-items-center gap-2">
                            <i class="bi bi-clock fs-2 text-warning"></i>
                            <h3 class="text-warning m-0">@Model.EnProceso</h3>
                            </div>
                            <div class="text-dark fw-bold">EN PROCESO</div>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="p-3 bg-light rounded shadow-sm text-center">
                            <div class="d-flex justify-content-center align-items-center gap-2">
                            <i class="bi bi-check2-circle fs-2 text-success"></i>
                            <h3 class="text-success m-0">@Model.Finalizadas</h3>
                            </div>
                            <div class="text-dark fw-bold">FINALIZADAS</div>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="p-3 bg-light rounded shadow-sm text-center">
                            <div class="d-flex justify-content-center align-items-center gap-2">
                            <i class="bi bi-x-circle fs-2 text-danger"></i>
                            <h3 class="text-danger m-0">@Model.Descartadas</h3>
                            </div>
                            <div class="text-dark fw-bold">DESCARTADAS</div>
                        </div>
                    </div>
                </div>

                <div class="card mt-4 shadow-sm">
                    <div class="card-header">
                        <h5 class="mb-0">Recientes</h5>
                    </div>

                    <div class="card-body">

                        @foreach (var inc in Model.Recientes)
                        {
                            <div class="container mt-4 p-0">

                                <div class="card mb-3 shadow" style="border-radius: 20px; overflow: hidden;">
                                    <div class="row g-0" style="height:140px">

                                        @* Imagen izquierda *@
                                        <div class="col-md-2" style="max-height: 250px; overflow: hidden;">
                                            @if (!string.IsNullOrEmpty(inc.imagenIncidencia))
                                            {
                                                <img src="@inc.imagenIncidencia"
                                                     alt="@inc."
                                                     class="img-fluid h-100 w-100 object-fit-cover" />
                                            }
                                        </div>

                                        @* Contenido derecho  *@
                                        <div class="col-md-10">
                                            <div class="card-body" style="height:90%">
                                                <div class="d-flex justify-content-between">
                                                    <p class="card-text text-muted">
                                                        <i class="bi bi-bookmark me-2"></i>@inc.Categoria?.nombre
                                                    </p>
                                                    <div>
                                                        @switch (inc.estadoIncidencia)
                                                        {
                                                            case EstadoIncidencia.reportado:
                                                                <span class="badge rounded-pill bg-info fs-6 ">REPORTADO</span>
                                                                break;
                                                            case EstadoIncidencia.asignado:
                                                                <span class="badge rounded-pill bg-warning fs-6">ASIGNADO</span>
                                                                break;
                                                            case EstadoIncidencia.enReparacion:
                                                                <span class="badge rounded-pill bg-primary fs-6">REPARACIÓN</span>
                                                                break;
                                                            case EstadoIncidencia.descartado:
                                                                <span class="badge rounded-pill bg-danger fs-6">DESCARTADO</span>
                                                                break;
                                                            case EstadoIncidencia.finalizado:
                                                                <span class="badge rounded-pill fs-6" style="background-color:#8b78b8">FINALIZADO</span>
                                                                break;
                                                        }
                                                        <a class="btn btn-light"
                                                           asp-controller="Incidencia"
                                                           asp-action="Details"
                                                           asp-route-id="@inc.id">
                                                            <i class="bi bi-arrow-up-right-square"></i>
                                                        </a>
                                                    </div>
                                                </div>
                                                <h3 class="card-title">@inc.titulo</h3>
                                                <p class="card-text">
                                                    @inc.descripcion
                                                </p>
                                            </div>
                                            <div class="mt-auto text-start" style="margin-left:20px">
                                                <span>Reportado:</span>
                                                <span>@inc.fechaReporte.ToString("dd/MM/yyyy HH:mm")</span>
                                            </div>
                                        </div>

                                    </div>
                                </div>

                            </div>
                        }

                        @if (!Model.Recientes.Any())
                        {
                            <p class="text-muted text-center">No hay incidencias recientes.</p>
                        }

                    </div>
            </div>
         </div>
    </div>
</div>
</div>