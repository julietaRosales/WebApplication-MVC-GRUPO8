@model WebApplication_MVC_GRUPO8.ViewModels.AsignacionIncidenciaViewModel

@{
    ViewData["Title"] = "Asignar";
}
<div class="container mt-3">
    <div class="row mb-4">
        <div class="col-12">
            <a asp-action="Details" asp-route-id="@Model.IdIncidencia" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
        </div>
    </div>
<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white">
<h3 class="text-center">Asignar incidencia #@Model.IdIncidencia</h3>
</div>
<div class="p-3">
<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Asignar" method="post">
    <div class="container mt-4">

        <div class="card mb-3 shadow" style="border-radius: 20px; overflow: hidden;">
            <div class="row g-0" style="height:230px">

                 @* Imagen izquierda *@
                <div class="col-md-4" style="max-height: 250px; overflow: hidden;">
                    @if (!string.IsNullOrEmpty(Model.ImagenIncidencia))
                    {
                        <img src="@Model.ImagenIncidencia"
                             alt="@Model.Titulo"
                             class="img-fluid h-100 w-100 object-fit-cover" />
                    }
                </div>

             @* Contenido derecho  *@
                <div class="col-md-8">
                    <div class="card-body" style="height:90%">
                        <div class="d-flex justify-content-between">
                            <p class="card-text text-muted">
                                <i class="bi bi-bookmark me-2"></i>@Model.NombreCategoria
                            </p>
                            <div>
                                @switch (Model.EstadoIncidencia)
                                {
                                    case EstadoIncidencia.reportado:
                                        <span class="badge rounded-pill bg-info fs-6 ">REPORTADO</span>
                                        break;
                                    case EstadoIncidencia.asignado:
                                        <span class="badge rounded-pill bg-warning fs-6">ASIGNADO</span>
                                        break;
                                    case EstadoIncidencia.enReparacion:
                                        <span class="badge rounded-pill bg-primary fs-6">EN REPARACION</span>
                                        break;
                                    case EstadoIncidencia.descartado:
                                        <span class="badge rounded-pill bg-danger fs-6">DESCARTADO</span>
                                        break;
                                     case EstadoIncidencia.finalizado:
                                         <span class="badge rounded-pill fs-6" style="background-color:#8b78b8">FINALIZADO</span>
                                         break;
                                }
                            </div>
                        </div>
                        <h3 class="card-title">@Model.Titulo</h3>
                        <p class="card-text">
                            @Model.Descripcion
                        </p>
                    </div>
                    <div class="mt-auto text-start" style="margin-left:20px">
                        <span>Reportado:</span>
                        <span>@Model.FechaReporte.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                </div>

            </div>
        </div>

    </div>

    <input type="hidden" asp-for="IdIncidencia" />
    <div class="p-3">
    <div class="mb-3">
        <label asp-for="IdTecnico" class="form-label fw-bold">Usuario a asignar</label>
        <select asp-for="IdTecnico"
                class="form-select"
                asp-items="ViewBag.Tecnicos">
            <option value="">-- Seleccione usuario --</option>
        </select>
        <span asp-validation-for="IdTecnico" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Prioridad" class="form-label fw-bold">Prioridad</label>
    <select asp-for="Prioridad"
            class="form-select"
            asp-items="ViewBag.Prioridades">
        <option value="">-- Seleccione prioridad --</option>
    </select>
        <span asp-validation-for="Prioridad" class="text-danger"></span>
    </div>

    <div class="mb-3">
                        <label asp-for="Complejidad" class="form-label fw-bold">Complejidad</label>
                        <select asp-for="Complejidad"
                class="form-select"
                asp-items="ViewBag.Complejidades">
            <option value="">-- Seleccione complejidad --</option>
        </select>
            <span asp-validation-for="Complejidad" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ComentarioNuevo" class="form-label fw-bold"></label>
        <textarea asp-for="ComentarioNuevo" class="form-control" rows="4"></textarea>
        <span asp-validation-for="ComentarioNuevo" class="text-danger"></span>
    </div>
    @* Botones *@
    <div class="d-grid gap-2 d-md-flex justify-content-md-center mt-4">
        <button type="submit" class="btn btn-primary">
                    <i class="bi bi-person-check"></i>
            Asignar
        </button>
    </div>
    </div>
</form>

    </div>
</div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
