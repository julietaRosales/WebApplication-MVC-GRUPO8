@model WebApplication_MVC_GRUPO8.ViewModels.EvaluacionIncidenciaViewModel

@{
    ViewData["Title"] = "Evaluar";
}
<div class="container mt-3">
<div class="row mb-4">
    <div class="col-12">
        <a asp-action="Details" asp-route-id="@Model.IdIncidencia" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>
</div>
<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white">
        <h3 class="text-center">Evaluar incidencia #@Model.IdIncidencia</h3>
    </div>
    <div class="p-3">
<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Evaluar" method="post">
    <div class="container mt-4 p-0">

        <div class="card mb-3 shadow" style="border-radius: 20px; overflow: hidden;">
                        <div class="row g-0" style="height:230px">

                 @* Imagen izquierda *@
                <div class="col-md-4" style="max-height: 250px; overflow: hidden;">
                    @if (!string.IsNullOrEmpty(Model.ImagenIncidencia))
                    {
                        <img src="@Model.ImagenIncidencia"
                             alt="@Model.Titulo"
                             class="img-fluid h-100 w-100 object-fit-cover" />
                    }
                </div>

             @* Contenido derecho  *@
                <div class="col-md-8">
                    <div class="card-body" style="height:90%">
                        <div class="d-flex justify-content-between">
                            <p class="card-text text-muted">
                                <i class="bi bi-bookmark me-2"></i>@Model.NombreCategoria
                            </p>
                            <div>
                                @switch (Model.EstadoIncidencia)
                                {
                                    case EstadoIncidencia.reportado:
                                        <span class="badge rounded-pill bg-info fs-6 ">REPORTADO</span>
                                        break;
                                    case EstadoIncidencia.asignado:
                                        <span class="badge rounded-pill bg-warning fs-6">ASIGNADO</span>
                                        break;
                                    case EstadoIncidencia.enReparacion:
                                        <span class="badge rounded-pill bg-primary fs-6">EN REPARACION</span>
                                        break;
                                    case EstadoIncidencia.descartado:
                                        <span class="badge rounded-pill bg-danger fs-6">DESCARTADO</span>
                                        break;
                                    case EstadoIncidencia.finalizado:
                                         <span class="badge rounded-pill fs-6" style="background-color:#8b78b8">FINALIZADO</span>
                                         break;
                                }
                            </div>
                        </div>
                        <h3 class="card-title">@Model.Titulo</h3>
                        <p class="card-text">
                            @Model.Descripcion
                        </p>

                    </div>
                    <div class="mt-auto text-start" style="margin-left:20px">
                        <span>Reportado:</span>
                        <span>@Model.FechaReporte.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                </div>

            </div>
        </div>

    </div>
    <input type="hidden" asp-for="IdIncidencia" />
    <div class="mb-3 mt-5">
        <label asp-for="ComentarioEvaluacion" class="form-label">Comentario de Evaluacion</label>
        <textarea asp-for="ComentarioEvaluacion" class="form-control" rows="4"></textarea>
        <span asp-validation-for="ComentarioEvaluacion" class="text-danger"></span>
    </div>
    @* Botones *@
    <div class="d-grid gap-2 d-md-flex justify-content-md-center mt-4">
        <button type="submit" class="btn btn-primary" style="width:110px">
            <i class="bi bi-tools"></i> Reparar
        </button>
    </div>
</form>
</div>
</div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
