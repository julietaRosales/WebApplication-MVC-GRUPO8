@model WebApplication_MVC_GRUPO8.ViewModels.DetalleIncidenciaViewModel

@{
	ViewData["Title"] = "Detalle de Incidencia";
}

<div class="container mt-4">
	<div class="row">
		<div class="col-12">
			<a asp-action="Index" class="btn btn-outline-secondary mb-3">
				<i class="bi bi-arrow-left"></i> Ir al listado
			</a>
		</div>
	</div>

	<div class="card shadow-sm mb-4">

		<div class="card-header bg-primary text-white">
				<h3 class="text-center">Incidencia #@Model.Id</h3>
			</div>
		 <div class="p-3">
				@* @* CARD principal *@
				<div class="container mt-4 p-0">

					<div class="card mb-3 shadow" style="border-radius: 20px; overflow: hidden;">
						<div class="row g-0">

							<!-- Imagen izquierda -->
							<div class="col-md-4" style="max-height: 250px; overflow: hidden;">
								@if (!string.IsNullOrEmpty(Model.ImagenIncidencia))
								{
									<img src="@Model.ImagenIncidencia"
									alt="@Model.Titulo"
									class="img-fluid h-100 w-100 object-fit-cover" />
								}
							</div>

							<!-- Contenido derecho -->
							<div class="col-md-8">
								<div class="card-body " style="height:90%">
									<div class="d-flex justify-content-between">
										<p class="card-text text-muted">
											<i class="bi bi-bookmark me-2"></i>@Model.NombreCategoria
										</p>
										<div>
											@switch (Model.EstadoIncidencia)
											{
												case EstadoIncidencia.reportado:
													<span class="badge rounded-pill bg-info text-dark fs-6 ">Reportado</span>
													break;
												case EstadoIncidencia.asignado:
													<span class="badge rounded-pill bg-warning fs-6">Asignado</span>
													break;
												case EstadoIncidencia.enReparacion:
													<span class="badge rounded-pill bg-primary fs-6">En reparacion</span>
													break;
												case EstadoIncidencia.descartado:
													<span class="badge rounded-pill bg-danger fs-6">Descartado</span>
													break;
											}
										</div>
									</div>


									<h3 class="card-title">@Model.Titulo</h3>

									<p class="card-text">
										@Model.Descripcion
									</p>
								</div>
								<div class="mt-auto text-start" style="margin-left:20px">
									<span>Fecha reportado:</span>
									<span>@Model.FechaReporte.ToString("dd/MM/yyyy HH:mm")</span>
								</div>

							</div>

						</div>
					</div>

				</div>
			@* DETALLE *@
			<div class="card shadow-sm mb-4">
				<div class="card-header">
					<h5 class="mb-0"><i class="bi bi-file-text"></i> Detalles</h5>
				</div>

				<div class="card-body">
					<div class="row mb-3">
						<div class="col-md-6">
							<strong>Reportado por:</strong>
							<span>@Model.NombreUsuarioReporta</span>
						</div>
						@if (!string.IsNullOrEmpty(Model.NombreEncargado) && Model.NombreEncargado != "Sin asignar")
						{
							<div class="col-md-6">
								<strong>Encargado:</strong>
								<span>@Model.NombreEncargado</span>
							</div>
						}
					</div>
					@if (!string.IsNullOrEmpty(Model.NombreEncargado) && Model.NombreEncargado != "Sin asignar")
					{
						<div class="row mb-3">
							<div class="col-md-6">
								@if (Model.Prioridad.HasValue)
								{
									<strong>Prioridad:</strong>
									@switch (Model.Prioridad.Value)
									{
										case Prioridad.alta:
											<span class="badge bg-danger">ALTA</span>
											break;
										case Prioridad.media:
											<span class="badge bg-warning text-dark">MEDIA</span>
											break;
										case Prioridad.baja:
											<span class="badge bg-success">BAJA</span>
											break;
									}
								}
							</div>
							<div class="col-md-6">
								@if (Model.Complejidad.HasValue)
								{
									<strong>Complejidad:</strong>
									@switch (Model.Complejidad.Value)
									{
										case Complejidad.dificil:
											<span class="badge bg-danger">DIFICIL</span>
											break;
										case Complejidad.intermedio:
											<span class="badge bg-warning text-dark">INTERMEDIO</span>
											break;
										case Complejidad.facil:
											<span class="badge bg-success">FACIL</span>
											break;
									}
								}
							</div>
						</div>
					}
					@if (!string.IsNullOrEmpty(Model.NombreEncargado) && Model.NombreEncargado != "Sin asignar"){
					<div class="row mb-3">
						<div class="col-md-6">
							<strong>Técnico:</strong>
							<span>@Model.NombreTecnico</span>
						</div>

						<div class="col-md-6">
							<strong>Fecha  Asignación:</strong>
							@if (Model.FechaAsignacion.HasValue)
							{
								<span>@Model.FechaAsignacion.Value.ToString("dd/MM/yyyy HH:mm") </span>
							}
							else
							{<span>-</span>
							
							}
						</div>

					</div>
					<div class="row mb-3">
						<div class="col-md-6">
							<strong>SLA (horas):</strong>
							@if (Model.Sla.HasValue)
							{
								<span>@Model.Sla.Value.ToString("0") </span>
							}
							else
							{
								<span>-</span>
							}
						</div>
						</div>
					
				}
				</div>
			</div>
			@* REPARACION *@
				@if (Model.FechaInicioReparacion.HasValue)
				{
					<div class="card shadow-sm mb-4">
						<div class="card-header">
							<h5 class="mb-0"><i class="bi bi-tools"></i> Reparación</h5>
						</div>
						<div class="card-body">
							<div class="row mb-3">
								@if (Model.FechaInicioReparacion.HasValue){
								<div class="col-md-6">
									<strong>Fecha inicio:</strong>
										<span>@Model.FechaInicioReparacion.Value.ToString("dd/MM/yyyy HH:mm")</span>
								</div>
								}
								@if (Model.FechaFinReparacion.HasValue)
								{
									<div class="col-md-6">
										<strong>Fecha fin:</strong>
										<span>@Model.FechaFinReparacion.Value.ToString("dd/MM/yyyy HH:mm")</span>
									</div>
								}
						</div>
						<div class="row mb-3">
							@if (Model.CostoTotal.HasValue)
							{
								<div class="col-md-6">
									<strong>Costo total:</strong>
									<span>$@Model.CostoTotal.Value.ToString("N2")</span>
								</div>
							}
							@if (!string.IsNullOrEmpty(Model.DescripcionGasto) && (Model.DescripcionGasto != "-"))
							{
								<div class="row mb-3">
									<strong>Descripción del Gasto:</strong>
									<span>@Model.DescripcionGasto</span>
								</div>
							}
						</div>
					</div>
					@if (!string.IsNullOrEmpty(Model.ImagenFinalIncidencia) && (Model.ImagenFinalIncidencia != "-"))
					{
							<div>
							<strong>Imagen de incidencia finalizada:</strong>
								<img src="@Model.ImagenFinalIncidencia"
									 alt="Resultado final"
									 class="img-fluid w-100"
									 style="max-height: 400px; object-fit: contain; background-color: #f8f9fa;">
							</div>
					}
					</div>
				}

			@* COMENTARIO *@
			@{
				var comentarios = ViewBag.Comentarios as List<WebApplication_MVC_GRUPO8.ViewModels.ComentarioListaVM>;
			}
			<div class="card shadow-sm mb-4">
				<div class="card-header">
					<div class="d-flex justify-content-between align-items-start">
					<h5 class="mb-0 "><i class="bi bi-chat-square-text"></i> Comentarios</h5>
					@* Botón de comentarios (todos pueden comentar) *@
					<a asp-controller="Comentario"
					   asp-action="Create"
					   asp-route-idIncidencia="@Model.Id"
					   class="btn" style="background-color: #47a478; color:white">
						<i class="bi bi-plus-circle"></i>
						Agregar
					</a>
					</div>
				</div>
				@if (comentarios != null && comentarios.Any())
				{

					<ol class="list-group list-group-numbered">
						@foreach (var c in comentarios)
						{
							<li class="list-group-item d-flex justify-content-between align-items-start" style="border-radius:0">
								<div class="ms-2 me-auto">
									<div class="fw-bold">
										<strong>@c.NombreUsuario @c.ApellidoUsuario</strong>
									</div>
									@c.Texto
								</div>

								<small class="text-muted">(@c.FechaComentario.ToString("dd/MM/yyyy HH:mm"))</small>
							</li>
						}
					</ol>
				}
				else
				{
					<p class="text-muted">No hay comentarios para esta incidencia.</p>
				}
			</div>

			@* Card: DESCARTADA *@
			@if (!string.IsNullOrEmpty(Model.JustificacionDescarte) && Model.JustificacionDescarte != "-")
			{
				<div class="card shadow-sm mb-4">
					<div class="card-header" style="background-color: #ffa1aa; border-color: #ff1a30;">
						<h5 class="mb-0"><i class="bi bi-x-circle"></i> Descartada</h5>
					</div>

					<div class="card-body">
						<div class="row mb-3">
							@if (!string.IsNullOrEmpty(Model.NombreUserDescarta) && Model.NombreUserDescarta != "Sin asignar")
							{
								<div class="col-md-6">
									<strong>Descartado por:</strong>
									<span>@Model.NombreUserDescarta</span>
								</div>
							}
							<div class="col-md-6">
								<strong>Fecha:</strong>
								<span>@Model.FechaDescarte?.ToString("dd/MM/yyyy HH:mm")</span>
							</div>
						</div>
						<div class="row mb-3">
							<div class="col-md-6">
								<strong>Justificación:</strong>
								<span>@Model.JustificacionDescarte</span>
							</div>
						</div>
					</div>
				</div>
			}

			@* Botones de acción (según el estado) *@
			<div class="d-flex justify-content-center gap-2">
					@{
						var rolActual = (RolUsuario)ViewBag.RolUsuarioActual;
						var esTecnicoAsignado = (bool)ViewBag.EsTecnicoAsignado;
					}

					@* ADMINISTRADOR - Puede hacer todo *@
					@if (rolActual == RolUsuario.administrador)
					{
						@if (Model.EstadoIncidencia == EstadoIncidencia.reportado)
						{
									<a asp-action="Asignar" asp-route-id="@Model.Id" class="btn btn-primary">
										<i class="bi bi-person-check"></i> 
										Asignar Técnico
									</a>
									
						
									<a asp-action="Descartar" asp-route-id="@Model.Id" class="btn btn-danger">
										<i class="bi bi-x-circle"></i> 	
										Descartar
									</a>
								

						}

						@if (Model.EstadoIncidencia == EstadoIncidencia.asignado)
						{
									<a asp-action="Evaluar" asp-route-id="@Model.Id" class="btn btn-info">
										@* <i class="bi bi-clipboard-check"></i>  *@
										Evaluar
									</a>
				<a asp-action="Descartar" asp-route-id="@Model.Id" class="btn btn-danger">
					<i class="bi bi-x-circle"></i>
					Descartar
				</a>

						}

						@if (Model.EstadoIncidencia == EstadoIncidencia.enReparacion)
						{
									<a asp-action="FinalizarReparacion" asp-route-id="@Model.Id" class="btn btn-success">
										@* <i class="bi bi-check-circle"></i> *@
										Finalizar Reparación
									</a>
						}
					}

					@* ENCARGADO - Asigna, evalua y repara si se asigno a si mismo *@
					@if (rolActual == RolUsuario.encargado)
					{
						@if (Model.EstadoIncidencia == EstadoIncidencia.reportado)
						{
									<a  asp-action="Asignar" asp-route-id="@Model.Id" class="btn btn-primary">
										<i class="bi bi-person-check"></i> 
										 Asignar Técnico
									</a>
									<a asp-action="Descartar" asp-route-id="@Model.Id" class="btn btn-danger">
												<i class="bi bi-x-circle"></i>
												Descartar 
									</a>
						}

						@* Si esta asignado y es el tecnico asignado *@
						@if (Model.EstadoIncidencia == EstadoIncidencia.asignado && esTecnicoAsignado)
						{
									<a asp-action="Evaluar" asp-route-id="@Model.Id" class="btn btn-info">
										@* <i class="bi bi-clipboard-check"></i> *@
										Evaluar
									</a>
									 <a asp-action="Descartar" asp-route-id="@Model.Id" class="btn btn-danger"> 
								 		@* <i class="bi bi-x-circle"></i>  *@
										 Descartar 
									</a> 
						}

						@if (Model.EstadoIncidencia == EstadoIncidencia.enReparacion && esTecnicoAsignado)
						{
									<a asp-action="FinalizarReparacion" asp-route-id="@Model.Id" class="btn btn-success">
										<i class="bi bi-check-circle"></i> Finalizar Reparación
									</a>
						}
					}

					@* TECNICO - Solo puede operar en sus incidencias asignadas *@
					@if (rolActual == RolUsuario.tecnico && esTecnicoAsignado)
					{
						@if (Model.EstadoIncidencia == EstadoIncidencia.asignado)
						{
									<a asp-action="Evaluar" asp-route-id="@Model.Id" class="btn btn-info">
										<i class="bi bi-clipboard-check"></i> Evaluar
									</a>
									<a asp-action="Descartar" asp-route-id="@Model.Id" class="btn btn-danger">
										<i class="bi bi-x-circle"></i> Descartar
									</a>
						}

						@if (Model.EstadoIncidencia == EstadoIncidencia.enReparacion)
						{
									<a asp-action="FinalizarReparacion" asp-route-id="@Model.Id" class="btn btn-success">
										<i class="bi bi-check-circle"></i> Finalizar Reparación
									</a>
						}
					}

					@* USUARIO - No ve botones de acción, solo puede reportar *@
					@if (rolActual == RolUsuario.usuario)
					{
							<div class="alert alert-info">
								<i class="bi bi-info-circle"></i> 
								Tu incidencia está siendo procesada por el equipo de mantenimiento.
							</div>
					}

				</div>
			</div>
	</div>

</div>