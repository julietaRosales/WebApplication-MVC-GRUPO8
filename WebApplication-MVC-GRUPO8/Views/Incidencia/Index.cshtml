@model IEnumerable<WebApplication_MVC_GRUPO8.Models.Incidencia>

@{
    ViewData["Title"] = "Incidencias";
    string rol = ViewBag.Rol ?? "";
    bool mostrarTodas = ViewBag.MostrarTodas ?? false;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Incidencias</h1>

        <div>
            <a asp-action="Create" class="btn btn-primary me-2">
                <i class="bi bi-plus-circle"></i> Reportar Incidencia
            </a>

            @if (!mostrarTodas)
            {
                <a asp-action="Index" asp-route-mostrarTodas="true" class="btn btn-outline-dark">
                    <i class="bi bi-list-ul"></i> Mostrar todas
                </a>
            }
            else
            {
                <a asp-action="Index" asp-route-mostrarTodas="false" class="btn btn-outline-dark @(rol == "administrador" ? "disabled" : "")" >
                    <i class="bi bi-person-badge"></i> Mostrar mis incidencias
                </a>
            }
        </div>
    </div>

    <div class="card shadow">
        <div class="card-header bg-white text-dark text-center">
            <h4 class="m-0">
                @(mostrarTodas ? "Todas las incidencias" : "Mis incidencias")
            </h4>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Título</th>
                            <th>Estado</th>
                            <th>Reportado</th>
                            <th>Fecha Reportado</th>
									<th>Prioridad</th>
									<th>Complejidad</th>
                            <th>Asignado</th>
									<th>Fecha Inicio</th>
									<th>Fecha Fin</th>
                            <th class="text-center">Ver Detalle</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
										<td>
											<strong>#@item.id</strong>
										</td>
										<td>
											<div class="d-flex align-items-center">
												@if (!string.IsNullOrEmpty(item.imagenIncidencia))
												{
													<img src="@item.imagenIncidencia" 
													alt="Thumbnail" 
													class="rounded me-2" 
													style="width: 50px; height: 50px; object-fit: cover;" />
												}
												<div>
													<strong>@item.titulo</strong>
													<br />
													<small class="text-muted">
														@(item.descripcion.Length > 50 ?
																																						item.descripcion.Substring(0, 50) + "..." :
																																						item.descripcion)
													</small>
												</div>
											</div>
										</td>
										<td>
                                    @switch (item.estadoIncidencia)
                                    {
                                        case EstadoIncidencia.reportado:
													<span class="badge rounded-pill bg-info text-white" style="width:100px">REPORTADO</span>
                                            break;
                                        case EstadoIncidencia.asignado:
													<span class="badge rounded-pill bg-warning text-white" style="width:100px">ASIGNADO</span>
													break;
                                        case EstadoIncidencia.enReparacion:
													<span class="badge rounded-pill bg-primary text-white" style="width:100px">REPARACIÓN</span>
													break;
                                        case EstadoIncidencia.descartado:
													<span class="badge rounded-pill bg-danger text-white" style="width:100px">DESCARTADO</span>
													break;
                                        case EstadoIncidencia.finalizado:
													<span class="badge rounded-pill text-white" style="background-color:#8b78b8;width:100px">FINALIZADO</span>
													break;
												default:
													<span class="badge rounded-pill bg-light text-white" style="background-color:#8b78b8; width:100px">@item.estadoIncidencia</span>
													break;
                                    }
                                </td>

										<td>
											@if (item.Usuario != null)
											{
												<span>@item.Usuario.nombre @item.Usuario.apellido</span>
											}
											else
											{
												<span class="text-muted">Usuario desconocido</span>
											}
										</td>
										<td>
											@item.fechaReporte.ToString("dd/MM/yyyy HH:mm")
										</td>
										<td>
											@if (item.prioridad.HasValue)
											{
												switch (item.prioridad.Value)
												{
													case Prioridad.alta:
														<span class="badge border border-danger text-danger" style="width:50px">Alta</span>
														break;
													case Prioridad.media:
														<span class="badge badge border border-warning  text-warning" style="width:50px">Media</span>
														break;
													case Prioridad.baja:
														<span class="badge border border-success text-success" style="width:50px">Baja</span>
														break;
												}
											}
											else
											{
												<span class="text-muted">-</span>
											}
										</td>
										<td>
											@if (item.complejidad.HasValue)
											{
												switch (item.complejidad.Value)
												{
													case Complejidad.dificil:
														<span class="badge border border-danger text-danger" style="width:50px">Dificil</span>
														break;
													case Complejidad.intermedio:
														<span class="badge badge border border-warning  text-warning" style="width:50px">Inter</span>
														break;
													case Complejidad.facil:
														<span class="badge border border-success text-success" style="width:50px">Facil</span>
														break;
												}
											}
											else
											{
												<span class="text-muted">-</span>
											}
										</td>
										<td>
											@if (item.Tecnico != null)
											{
												<span>@item.Tecnico.nombre @item.Tecnico.apellido</span>
											}
											else
											{
												<span class="text-muted">Sin asignar</span>
											}
										</td>
										<td>
											@if (item.fechaInicioReparacion != null)
											{
												@item.fechaInicioReparacion
											}else
											{
												<span class="text-muted">-</span>
											}
										</td>
										<td>
											@if(item.fechaFinReparacion != null){
												@item.fechaFinReparacion
											}else
											{
												<span class="text-muted">-</span>
											}
										</td>
                                <td class="text-center">
									<div class="btn-group" role="group">
										<a asp-action="Details" asp-route-id="@item.id"
												   class="btn btn-sm btn btn-outline-secondary "
												   title="Ver Detalles">
                                        <i class="bi bi-eye"></i>
                                    </a>
									</div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (!Model.Any())
                {
                    <div class="alert alert-info text-center mt-3">
                        <i class="bi bi-info-circle"></i> No hay incidencias para mostrar.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
